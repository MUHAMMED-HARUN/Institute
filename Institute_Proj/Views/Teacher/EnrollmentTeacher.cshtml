@model BAL.ViewModel.clsEnrolmentTeacherInClassModel
@using BAL.ViewModel

@{
    SelectList ClassList = new SelectList(Model.ClassList, "ID", "ClassName", Model.ClassID <= 0 ? -1 : Model.ClassID);
    SelectList EnrollStatusList = new SelectList(Model.EnrollStatus.Select(e => new { Text = e.Key, Value = e.Value }), "Value", "Text", Model.EnrollmentStatus);
    var viewDataForTeacherCardWithPrefix = new ViewDataDictionary<clsTeacherTableViewModel>(ViewData, Model.TeacherTable);
    viewDataForTeacherCardWithPrefix.TemplateInfo.HtmlFieldPrefix = "TeacherTable";
}

<h4 class="mb-4">تسجيل المعلم في الصف</h4>
<hr />

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <form asp-action="EnrollInClass" method="post">
                <div asp-validation-summary="All" class="alert alert-danger d-none" role="alert"></div>

                <!-- عرض بطاقة المعلم -->
                <div class="form-group mb-4 teacher-table" id="enrollTeacherCard">
                    @await Html.PartialAsync("~/Views/Teacher/TeacherCardWithFilter.cshtml", Model.TeacherTable, viewDataForTeacherCardWithPrefix)
                </div>

                <!-- Hidden Field -->
                <input asp-for="TeacherID" id="EnrollTeacherID" hidden />

                <!-- معرف التسجيل -->
                <div class="form-group mb-3">
                    <label asp-for="EnrollmentID" class="form-label"></label>
                    <p id="EnrollmentID" class="form-control bg-light" readonly>@Model.EnrollmentID</p>
                    <span asp-validation-for="EnrollmentID" class="text-danger"></span>
                </div>

                <!-- اختيار الصف -->
                <div class="form-group mb-3">
                    <label asp-for="ClassID" class="form-label"></label>
                    <select asp-for="ClassID" asp-items="ClassList" class="form-select">
                        <option value="-1">اختر صفًا</option>
                    </select>
                    <span asp-validation-for="ClassID" class="text-danger"></span>
                </div>

                <!-- تاريخ التسجيل -->
                <div class="form-group mb-3">
                    <label asp-for="EnrolmentDate" class="form-label"></label>
                    <input asp-for="EnrolmentDate" class="form-control" />
                    <span asp-validation-for="EnrolmentDate" class="text-danger"></span>
                </div>

                <!-- نهاية التسجيل -->
                <div class="form-group mb-3">
                    <label asp-for="EnrollmentEndDate" class="form-label"></label>
                    <input asp-for="EnrollmentEndDate" class="form-control" />
                    <span asp-validation-for="EnrollmentEndDate" class="text-danger"></span>
                </div>

                <!-- حالة التسجيل -->
                <div class="form-group mb-3">
                    <label asp-for="EnrollmentStatus" class="form-label"></label>
                    <select asp-for="EnrollmentStatus" asp-items="EnrollStatusList" class="form-select">
                        <option value="-1">اختر حالة</option>
                    </select>
                    <span asp-validation-for="EnrollmentStatus" class="text-danger"></span>
                </div>

                <!-- زر الإرسال -->
                <div class="form-group mt-4 d-grid gap-2 d-md-flex justify-content-md-between">
                    <button type="submit" class="btn btn-primary btn-lg px-4">تسجيل</button>
                    <a asp-action="Index" class="btn btn-secondary btn-lg px-4">العودة إلى القائمة</a>
                </div>
            </form>
        </div>
    </div>
</div>