@model BAL.ViewModel.clsEnrolmentTeacherInClassModel
@using BAL.ViewModel
@{
    SelectList ClassList = new SelectList(Model.ClassList, "ID", "ClassName", Model.ClassID <= 0 ? -1 : Model.ClassID);
    SelectList EnrollStatusList = new SelectList(Model.EnrollStatus.Select(e => new { Text = e.Key, Value = e.Value }), "Value", "Text", Model.EnrollmentStatus);
    var viewDataForTeacherCardWithPrefix = new ViewDataDictionary<clsTeacherTableViewModel>(ViewData, Model.TeacherTable);
    viewDataForTeacherCardWithPrefix.TemplateInfo.HtmlFieldPrefix = "TeacherTable";
}

<h4>تسجيل المعلم في الصف</h4>
<hr />
<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script>
    document.addEventListener("TeacherCardUpdated", function (event) {
        const TeacherID = event.detail;
        if (TeacherID) {
            document.getElementById("EnrollTeacherID").value = TeacherID;
        }
    });
</script>

<div class="row">
    <div class="col-md-4">
        <form asp-action="EnrollInClass" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group teacher-table" id="enrollTeacherCard">
                @await Html.PartialAsync("~/Views/Teacher/TeacherCardWithFilter.cshtml", Model.TeacherTable, viewDataForTeacherCardWithPrefix)
            </div>

            <div>
                <span asp-validation-for="TeacherID" class="text-danger"></span>
                <input asp-for="TeacherID" id="EnrollTeacherID" hidden />
            </div>

            <div class="form-group">
                <label asp-for="EnrollmentID" class="control-label"></label>
                <p id="EnrollmentID">@Model.EnrollmentID</p>
                <span asp-validation-for="EnrollmentID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ClassID" class="control-label"></label>
                <select asp-for="ClassID" asp-items="ClassList">
                    <option value="-1">اختر صف</option>
                </select>
                <span asp-validation-for="ClassID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EnrolmentDate" class="control-label"></label>
                <input asp-for="EnrolmentDate" class="form-control" />
                <span asp-validation-for="EnrolmentDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EnrollmentEndDate" class="control-label"></label>
                <input asp-for="EnrollmentEndDate" class="form-control" />
                <span asp-validation-for="EnrollmentEndDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EnrollmentStatus" class="control-label"></label>
                <select asp-for="EnrollmentStatus" asp-items="EnrollStatusList">
                    <option value="-1">اختر حالة</option>
                </select>
                <span asp-validation-for="EnrollmentStatus" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="تسجيل" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">العودة إلى القائمة</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
