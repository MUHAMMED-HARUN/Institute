@model DAL.Models.TableFilters.clsTeacherFilter
@{
    int i = 1;
}

<h4 class="mb-3">قائمة المعلمين</h4>
<hr />

<div class="container-fluid">
    <div id="filterItem" class="mb-4 p-3 bg-light rounded shadow-sm">
        <div class="row g-3 align-items-center">

            <!-- خيار البحث -->
            <div class="col-12 col-md-auto d-flex align-items-center">
                <label for="searchFieldSelect" class="form-label mb-0 me-2">بحث حسب</label>
                <select id="searchFieldSelect" class="form-select w-auto">
                    <option selected value="-1">لا شيئ</option>
                    <option data-pattern="^\d{1,10}$" value="PersonID">المعرف الشخصي</option>
                    <option data-pattern="^\d{11}$" value="NationalNumber">الرقم الوطني</option>
                    <option data-pattern="^[\u0600-\u06FFa-zA-Z ]{2,50}$" value="FirstName">الاسم الأول</option>
                    <option data-pattern="^\d{1,10}$" value="TeacherID">معرف المعلم</option>
                </select>
                <input type="text" id="searchInput" name="" class="form-control ms-2" style="min-width: 200px;" disabled placeholder="" />
            </div>

            <!-- تصنيف حسب الجنس -->
            <div class="col-12 col-md-auto d-flex align-items-center">
                <p class="mb-0 me-3">تصنيف حسب الجنس</p>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" id="None" type="radio" name="Gendor" value="" />
                    <label class="form-check-label" for="None">لا شيء</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" id="male" type="radio" name="Gendor" value="true" />
                    <label class="form-check-label" for="male">ذكر</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" id="fmale" type="radio" name="Gendor" value="false" />
                    <label class="form-check-label" for="fmale">أنثى</label>
                </div>
            </div>

            <!-- من وإلى تاريخ -->
            <div class="col-12 col-md-auto d-flex align-items-center">
                <label for="minDate" class="col-form-label mb-0 me-2">من تاريخ</label>
                <input id="minDate" type="date" name="MinDate" class="form-control me-3" />
                <label for="maxDate" class="col-form-label mb-0 me-2">إلى تاريخ</label>
                <input id="maxDate" type="date" name="MaxDate" class="form-control" />
            </div>

            <!-- تصنيف حسب الحالة -->
            <div class="col-12 col-md-auto d-flex align-items-center">
                <p class="mb-0 me-3">تصنيف حسب الحالة</p>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" id="NoneActive" type="radio" name="IsActive" value="" />
                    <label class="form-check-label" for="NoneActive">لا شيء</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" id="Active" type="radio" name="IsActive" value="true" />
                    <label class="form-check-label" for="Active">مفعل</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" id="not-Active" type="radio" name="IsActive" value="false" />
                    <label class="form-check-label" for="not-Active">غير مفعل</label>
                </div>
            </div>

            <!-- أزرار البحث وإعادة التعيين -->
            <div class="col-12 col-md-auto d-flex align-items-center gap-2">
                <button type="button" id="btnSearch" class="btn btn-primary">بحث</button>
                <button type="button" id="btnReset" class="btn btn-secondary">إرجاع</button>
            </div>
        </div>
    </div>

    <!-- رابط الإضافة -->
    <div class="mb-3">
        <a asp-action="NewOrEdit" asp-controller="Teacher" class="btn btn-success">
            <i class="fas fa-user-plus me-1"></i> إضافة معلم جديد
        </a>
    </div>

    <!-- جدول العرض -->
    <div class="table-responsive">
        <table class="table table-hover table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th scope="col">معرف المعلم</th>
                    <th scope="col">المعرف الشخصي</th>
                    <th scope="col">الرقم الوطني</th>
                    <th scope="col">الاسم الكامل</th>
                    <th scope="col">رقم التواصل</th>
                    <th scope="col">الجنس</th>
                    <th scope="col">تاريخ الولادة</th>
                    <th scope="col">الحالة</th>
                    <th scope="col">تاريخ التسجيل</th>
                    <th scope="col">الإجراءات</th>
                </tr>
            </thead>
            <tbody id="resultTableBody">
                @if (Model.TeacherTableView != null && Model.TeacherTableView.Any())
                {
                    foreach (var teacher in Model.TeacherTableView)
                    {
                        <tr class="@($"row-info{i}")">
                            <td>@teacher.TeacherID</td>
                            <td>@teacher.PersonID</td>
                            <td>@teacher.NationalNumber</td>
                            <td>@teacher.FullName</td>
                            <td>@teacher.PhoneNumber</td>
                            <td>@teacher.GendorText</td>
                            <td>@(teacher.BirthDate?.ToString("yyyy-MM-dd"))</td>
                            <td>@teacher.IsActiveText</td>
                            <td>@(teacher.EntryDate?.ToString("yyyy-MM-dd"))</td>
                            <td class="text-nowrap">
                                <a asp-action="NewOrEdit" 
                                   asp-controller="Teacher" 
                                   asp-route-TeacherID="@teacher.TeacherID" 
                                   class="btn btn-sm btn-warning me-1">
                                    <i class="fas fa-user-pen me-1"></i> تعديل
                                </a>
                                <button class="btn btn-sm btn-info showTeacherCard" 
                                        data-id-info="@teacher.TeacherID" 
                                        data-tr-class-info="@($"row-info{i}")">
                                    <i class="fas fa-address-card me-1"></i> عرض الكارت
                                </button>
                                <button class="btn btn-sm btn-danger DeleteTeacher" 
                                        data-id-info="@teacher.TeacherID" 
                                        data-row-class-info="@($"row-info{i}")">
                                    <i class="fas fa-user-xmark me-1"></i> حذف
                                </button>
                            </td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-muted text-center">لا توجد معلمين مسجلين حتى الآن.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- سكريبت jQuery -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<!-- سكريبت AJAX -->
<script>
    $(document).ready(function () {
        $("#searchFieldSelect").on("change", function () {
            const selectedValue = $(this).val();
            const input = $("#searchInput");

            if (selectedValue === "-1") {
                input.attr("name", "").val("").prop("disabled", true);
            } else {
                input.attr("name", selectedValue).prop("disabled", false)
                     .attr("placeholder", "أدخل " + $(this).find("option:selected").text());
            }
        });

        $("#btnSearch").on("click", function () {
            let input = $("#searchInput");
            let fieldName = input.attr("name");
            let fieldValue = input.val();

            if (!CheckIsValid(fieldValue)) return;

            let dataToSend = {
                Gendor: $('input[name="Gendor"]:checked').val(),
                MinDate: $('input[name="MinDate"]').val(),
                MaxDate: $('input[name="MaxDate"]').val(),
                IsActive: $('input[name="IsActive"]:checked').val()
            };

            if (fieldName && fieldName !== "-1") {
                dataToSend[fieldName] = fieldValue;
            }

            $.ajax({
                url: '/Teacher/Search',
                type: 'GET',
                data: dataToSend,
                success: function (data) {
                    $('#resultTableBody').html('');
                    data.forEach(function (d) {
                        const tr = `<tr>
                                <td>${d.teacherID}</td>
                                <td>${d.personID}</td>
                                <td>${d.nationalNumber}</td>
                                <td>${d.fullName}</td>
                                <td>${d.phoneNumber}</td>
                                <td>${d.gendorText}</td>
                                <td>${d.birthDate}</td>
                                <td>${d.isActiveText}</td>
                                <td>${d.entryDate}</td>
                                <td class="text-nowrap">
                                    <a href="/Teacher/NewOrEdit?TeacherID=${d.teacherID}" class="btn btn-sm btn-warning me-1">
                                        <i class="fas fa-user-pen me-1"></i> تعديل
                                    </a>
                                    <button class="btn btn-sm btn-info me-1 showTeacherCard" data-id-info="${d.teacherID}">
                                        <i class="fas fa-address-card me-1"></i> عرض الكارت
                                    </button>
                                    <button class="btn btn-sm btn-danger me-1 DeleteTeacher" data-id-info="${d.teacherID}">
                                        <i class="fas fa-user-xmark me-1"></i> حذف
                                    </button>
                                </td>
                            </tr>`;
                        $('#resultTableBody').append(tr);
                    });
                },
                error: function (xhr, status, error) {
                    alert("حدث خطأ أثناء البحث: " + error);
                }
            });
        });

        $("#btnReset").on("click", function () {
            $("#filterItem").find("input").val("");
            $("#filterItem").find(`input[type="radio"]`).prop('checked', false);
            $("#errorelement").remove();
        });

        $("#searchInput").on("input", function () {
            CheckIsValid($(this).val());
        });

        function CheckIsValid(fildValue) {
            const selectedOption = $("#searchFieldSelect option:selected");
            const pattern = new RegExp(selectedOption.data("pattern"));
            $("#errorelement").remove();

            if (!pattern.test(fildValue)) {
                const newElement = $("<p>", {
                    text: "القيمة غير صالحة",
                    class: "text-danger",
                    id: "errorelement"
                });
                $("#searchInput").after(newElement);
                return false;
            }
            return true;
        }

        // عرض كارت المعلم
        $(document).on("click", ".showTeacherCard", function () {
            const teacherID = $(this).data("idInfo");
            const trClass = $(this).closest("tr").attr("class");
            const trElement = $(`.${trClass}`).first();
            $("#TeacherCardPartial").remove();

            $.ajax({
                url: '/Teacher/ShowTeacherCard',
                type: 'GET',
                data: { TeacherID: teacherID },
                success: function (partialHtml) {
                    const newElement = NewHtmlElement("div", partialHtml, "TeacherCardPartial");
                    trElement.after(newElement);
                },
                error: function (xhr, status, error) {
                    console.error("AJAX error:", error);
                }
            });
        });

        // حذف المعلم
        $(document).on("click", ".DeleteTeacher", function () {
            const teacherID = $(this).data("idInfo");
            const rowClass = $(this).data("row-class-info");
            const trElement = $(`.${rowClass}`).first();

            if (confirm(`هل تريد حذف المعلم برقم الهوية ${teacherID}?`)) {
                $.ajax({
                    url: '/Teacher/DeleteTeacher',
                    type: 'GET',
                    data: { TeacherID: teacherID },
                    success: function (isDeleted) {
                        if (isDeleted) {
                            alert("تم الحذف بنجاح");
                            trElement.remove();
                        } else {
                            alert("فشل الحذف");
                        }
                    },
                    error: function () {
                        alert("فشل الاتصال بالخادم");
                    }
                });
            }
        });

        // إنشاء عنصر HTML جديد
        function NewHtmlElement(ElementTag, ElementInnerHtml, Elementid) {
            const Element = document.createElement(ElementTag);
            Element.innerHTML = ElementInnerHtml;
            Element.id = Elementid;
            return Element;
        }
    });
</script>