@model List<DAL.Models.clsReading>
@using BAL;
@{
    ViewData["Title"] = "إدارة القراءات";
}

<h2 class="mb-4">قائمة القراءات</h2>

<div class="mb-3">
    <a asp-action="NewOrEditReading" asp-route-ReadingDayID="1" asp-route-ID="1" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> إضافة قراءة جديدة
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover table-striped align-middle text-center">
        <thead class="table-dark">
            <tr>
                <th scope="col">اسم الطالب</th>
                <th scope="col">رقم الصفحة</th>
                <th scope="col">تقييم الأداء</th>
                <th scope="col">نوع القراءة</th>
                <th scope="col">تاريخ القراءة</th>
                <th scope="col">الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@(item.QuranStudent.student.Person.FirstName + ' ' + item.QuranStudent.student.Person.FatherName + ' ' + item.QuranStudent.student.Person.LastName)</td>
                        <td>@item.ReadedPageNum</td>
                        <td>@GlobalVar.GetPerformanceRating(item.PerformanceRating)</td>
                        <td>@GlobalVar.GetReadingType(item.ReadigType)</td>
                        <td>@item.ReadingDay.ReadingDate</td>
                        <td>
                            <a asp-action="NewOrEditReading"
                               asp-route-QuranStudentID="@item.QuranStudentID"
                               asp-route-ReadingID="@item.ID"
                               class="btn btn-sm btn-outline-primary me-1">
                                <i class="fas fa-edit me-1"></i> تعديل
                            </a>
                            <a asp-action="Delete"
                               asp-route-id="@item.ID"
                               class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-trash-alt me-1"></i> حذف
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-muted">لا توجد قراءات مسجلة حتى الآن.</td>
                </tr>
            }
        </tbody>
    </table>
</div>