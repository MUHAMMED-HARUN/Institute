@model BAL.ViewModel.clsReadingModel
@{
    ViewData["Title"] = Model.ReadingID == 0 ? "إضافة قراءة جديدة" : "تعديل قراءة";
    var Performance = new SelectList(Model.PerformaceList.Select(p => new { text = p.Key, Value = p.Value }), "Value", "text", Model.PerformaceRating);
    var ReadingType = new SelectList(Model.ReadingTypeList.Select(r => new { text = r.Key, Value = r.Value }), "Value", "text", Model.readingType);
}

<h4 class="mb-4">@ViewData["Title"]</h4>
<hr />

<form asp-action="NewOrEditReading" method="post">
    <!-- Hidden Field -->
    <input type="hidden" asp-for="ReadingID" />
    <label asp-for="ReadingID"></label>
    <p class="form-control bg-light" readonly>@Model.ReadingID</p>

    <!-- رقم الصفحة المقرؤة -->
    <div class="form-group mb-3">
        <label asp-for="ReadedPageNumer" class="form-label"></label>
		<p id="ReadedPageNumer">@Model.ReadedPageNumer</p>
        <span asp-validation-for="ReadedPageNumer" class="text-danger"></span>
    </div>

    <!-- تقييم الأداء -->
    <div class="form-group mb-3">
        <label asp-for="PerformaceRating" class="form-label"></label>
        <select asp-items="Performance" asp-for="PerformaceRating" class="form-select">
            <option value="">اختر تقييم</option>
        </select>
        <span asp-validation-for="PerformaceRating" class="text-danger"></span>
    </div>

    <!-- نوع القراءة -->
    <div class="form-group mb-3">
        <label asp-for="readingType" class="form-label"></label>
        <select asp-items="ReadingType" asp-for="readingType" class="form-select">
            <option value="">اختر نوع القراءة</option>
        </select>
        <span asp-validation-for="readingType" class="text-danger"></span>
    </div>

    <!-- معرف اليوم -->
    <div class="form-group mb-3">
        <label asp-for="ReadingDayID" class="form-label"></label>
        <input asp-for="ReadingDayID" hidden />
        <p id="ReadingDayID" class="form-control bg-light" readonly>@Model.ReadingDayID</p>
    </div>

    <!-- تاريخ اليوم -->
    <div class="form-group mb-3">
        <label asp-for="ReadingDay" class="form-label"></label>
        <p id="ReadingDay" class="form-control bg-light" readonly>@Model.ReadingDay</p>
    </div>

    <!-- اسم الطالب -->
    <div class="form-group mb-3">
        <label asp-for="QuranStudentName" class="form-label"></label>
        <input asp-for="QuranStudentID" hidden />
        <p id="QuranStudentName" class="form-control bg-light" readonly>@Model.QuranStudentName</p>
    </div>

    <!-- زر الإرسال -->
    <div class="form-group mt-4 d-grid gap-2 d-md-flex justify-content-md-between">
        <button type="submit" class="btn btn-primary btn-lg px-4">حفظ</button>
        <a asp-action="Index" class="btn btn-secondary btn-lg px-4">العودة إلى القائمة</a>
    </div>
</form>