@model List<DAL.Models.clsReadingDay>
@{
    ViewData["Title"] = "إدارة أيام القراءة";
}

<h2 class="mb-4">أيام القراءة</h2>

<div class="mb-3">
    <a asp-action="NewOrEditReadingDay" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> إضافة يوم جديد
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover table-striped align-middle text-center">
        <thead class="table-dark">
            <tr>
                <th scope="col">التاريخ</th>
                <th scope="col">الملاحظات</th>
                <th scope="col">الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ReadingDate.ToShortDateString()</td>
                        <td>@item.Discription</td>
                        <td>
                            <a asp-action="ReadingList" asp-route-ReadingDay="@item.ID" class="btn btn-sm btn-outline-success">
                                <i class="fas fa-book me-1"></i> عرض سجلات التسميع
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-muted">لا توجد أيام مسجلة حتى الآن.</td>
                </tr>
            }
        </tbody>
    </table>
</div>