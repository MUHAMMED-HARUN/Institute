@model BAL.ViewModel.clsStudentTableVieweModel
@{
    string prefix = ViewData.TemplateInfo.HtmlFieldPrefix ?? "";
    string uniqueId = prefix.Replace(".", "_");
}

<div class="student-card mb-4" data-prefix="@prefix">
    <!-- بطاقة المعلومات الشخصية -->
    <div class="person-info mb-4">
        @await Html.PartialAsync("~/Views/People/PersonCardPartial.cshtml", Model.clsPersonViewModel, ViewData)
    </div>

    <!-- معلومات الطالب -->
    <div class="student-info bg-light p-3 rounded shadow-sm">
        <div class="row row-cols-1 row-cols-md-2 g-3">

            <!-- معرف الطالب -->
            <div class="col d-flex align-items-center gap-4">
                <label asp-for="StudentID" class="fw-bold w-100 text-end">معرف الطالب</label>
                <p class="m-0 w-100 bg-white p-2 rounded border" id="StudentID_@uniqueId">@Model.StudentID</p>
            </div>

            <!-- تاريخ الدخول -->
            <div class="col d-flex align-items-center gap-4">
                <label asp-for="EntryDate" class="fw-bold w-100 text-end">تاريخ الدخول</label>
                <p class="m-0 w-100 bg-white p-2 rounded border" id="EntryDate_@uniqueId">@Model.EntryDate.ToString("yyyy-MM-dd")</p>
            </div>

            <!-- تاريخ الخروج -->
            <div class="col d-flex align-items-center gap-4">
                <label asp-for="ExitDate" class="fw-bold w-100 text-end">تاريخ الخروج</label>
                <p class="m-0 w-100 bg-white p-2 rounded border" id="ExitDate_@uniqueId">
                    @(Model.ExitDate.ToString("yyyy-MM-dd"))
                </p>
            </div>

            <!-- حالة التفعيل -->
            <div class="col d-flex align-items-center gap-4">
                <label asp-for="IsActive" class="fw-bold w-100 text-end">الحالة</label>
                <p class="m-0 w-100 bg-white p-2 rounded border" id="IsActive_@uniqueId">
                    @(Model.IsActive )
                </p>
            </div>

        </div>
    </div>
</div>