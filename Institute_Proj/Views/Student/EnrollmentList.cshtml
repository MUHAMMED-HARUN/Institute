@using DAL.Models.TableFilters
@model clsEnrollmentStudentInClassFilter

<h3 class="mb-4">قائمة التسجيل</h3>

<div class="container-fluid">
    <div id="filterItem" class="mb-4 p-3 bg-light rounded shadow-sm">
        <div class="row g-3 align-items-center">

            <!-- بحث حسب -->
            <div class="col-12 col-md-auto d-flex align-items-center">
                <label for="searchFieldSelect" class="form-label mb-0 me-2">بحث حسب</label>
                <select id="searchFieldSelect" class="form-select w-auto">
                    <option selected value="-1">لا شيئ</option>
                    <option data-pattern="^\d{1,10}$" value="StudentID">معرف الطالب</option>
                    <option data-pattern="^\d{11}$" value="NationalNumber">الرقم الوطني</option>
                    <option data-pattern="^[\u0600-\u06FFa-zA-Z ]{2,50}$" value="FullName">الاسم</option>
                    <option data-pattern="^\d{1,10}$" value="CalssID">معرف الصف</option>
                    <option data-pattern="^[\u0600-\u06FFa-zA-Z ]{2,50}$" value="ClassName">اسم الصف</option>
                </select>
                <input type="text" id="searchInput" name="" class="form-control ms-2" style="min-width: 200px;" disabled placeholder="" />
            </div>

            <!-- تصنيف حسب الحالة -->
            <div class="col-12 col-md-auto d-flex align-items-center">
                <p class="mb-0 me-3">تصنيف حسب الحالة</p>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" id="NoneActive" type="radio" name="IsActive" value="" />
                    <label class="form-check-label" for="NoneActive">لا شيء</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" id="Active" type="radio" name="IsActive" value="true" />
                    <label class="form-check-label" for="Active">مفعل</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" id="not-Active" type="radio" name="IsActive" value="false" />
                    <label class="form-check-label" for="not-Active">غير مفعل</label>
                </div>
            </div>

            <!-- أزرار البحث وإعادة التعيين -->
            <div class="col-12 col-md-auto d-flex align-items-center gap-2">
                <button type="button" id="btnSearch" class="btn btn-primary">بحث</button>
                <button type="button" id="btnReset" class="btn btn-secondary">إرجاع</button>
            </div>
        </div>
    </div>

    <!-- جدول العرض -->
    <table class="table table-hover table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>معرف التسجيل</th>
                <th>اسم الطالب</th>
                <th>رقم الهوية</th>
                <th>اسم الصف</th>
                <th>الحالة</th>
           @*       <th>حالة الدفع</th> *@
            </tr>
        </thead>
        <tbody id="resultTableBody">
            @for (int i = 0; i < Model.EnrollmentTable.Count; i++)
            {
                <tr>
                    <td>@Model.EnrollmentTable[i].ID</td>
                    <td>@Model.EnrollmentTable[i].FullName</td>
                    <td>@Model.EnrollmentTable[i].NationalNumber</td>
                    <td>@Model.EnrollmentTable[i].ClassName</td>
                    <td>@Model.EnrollmentTable[i].IsActive</td>
                    @* <td>@Model.EnrollmentTable[i].PaymentStatus</td> *@
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- رابط jQuery -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<!-- سكريبت AJAX -->
<script>
    $(document).ready(function () {
        $("#searchFieldSelect").on("change", function () {
            const selectedValue = $(this).val();
            const input = $("#searchInput");
            if (selectedValue === "-1") {
                input.attr("name", "").val("").prop("disabled", true);
            } else {
                input.attr("name", selectedValue).prop("disabled", false)
                    .attr("placeholder", "أدخل " + $(this).find("option:selected").text());
            }
        });

        $("#btnSearch").on("click", function () {
            let input = $("#searchInput");
            let fieldName = input.attr("name");
            let fieldValue = input.val();

            if (!CheckIsValid(fieldValue)) return;

            let dataToSend = {
                IsActive: $('input[name="IsActive"]:checked').val()
            };

            if (fieldName && fieldName !== "-1") {
                dataToSend[fieldName] = fieldValue;
            }

            $.ajax({
                url: '/Student/EnrollmentList',
                type: 'POST',
                data: dataToSend,
                success: function (data) {
                    $('#resultTableBody').html('');
                    data.forEach(function (d) {
                        const tr = `<tr>
                                    <td>${d.id}</td>
                                    <td>${d.fullName}</td>
                                    <td>${d.nationalNumber}</td>
                                    <td>${d.className}</td>
                                    <td>${d.isActive}</td>
                                    <td>${d.paymentStatus}</td>
                                </tr>`;
                        $('#resultTableBody').append(tr);
                    });
                },
                error: function (xhr, status, error) {
                    alert("حدث خطأ أثناء البحث: " + error);
                }
            });
        });

        $("#btnReset").on("click", function () {
            $("#filterItem").find("input").val("");
            $("#filterItem").find("input[type='radio']").prop('checked', false);
            $("#errorelement").remove();
        });

        function CheckIsValid(fildValue) {
            const selectedOption = $("#searchFieldSelect").find("option:selected");
            const pattern = new RegExp(selectedOption.data("pattern"));
            $("#errorelement").remove();

            if (!pattern.test(fildValue)) {
                const newElement = $("<p>", {
                    text: "القيمة غير صالحة",
                    class: "text-danger",
                    id: "errorelement"
                });
                $("#searchInput").after(newElement);
                return false;
            }
            return true;
        }
    });
</script>