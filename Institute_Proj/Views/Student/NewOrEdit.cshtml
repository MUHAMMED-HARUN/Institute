@model BAL.ViewModel.clsStudentViewModel
@using DAL.Models.TableViews

@{
    ViewData["Title"] = "NewOrEdit";
    var viewDataForPersonCardWithPrefix = new ViewDataDictionary<clsPersonTableView>(ViewData, Model.PersonTable);
    viewDataForPersonCardWithPrefix.TemplateInfo.HtmlFieldPrefix = "PersonTable";
}

<h1 class="mb-4">@(Model.StudentID == 0 ? "إضافة طالب جديد" : "تعديل بيانات الطالب")</h1>
    
<div class="container-fluid">
    <div class="row">
        <!-- عرض كارت الشخص -->
        <div class="col-md-6 mb-4">
            @await Html.PartialAsync("~/Views/People/PersonCardWithFilterPartila.cshtml", Model.PersonTable, viewDataForPersonCardWithPrefix)
        </div>

        <!-- نموذج البيانات -->
        <div class="col-md-6">
            <form asp-action="NewOrEdit" method="post">
                <div asp-validation-summary="All" class="alert alert-danger d-none" role="alert"></div>

                <!-- معرف الطالب (مخفي) -->
                <input asp-for="StudentID" id="StudentInput" hidden />

                <!-- معرف الشخص -->
                <div class="form-group mb-3">
                    <label asp-for="PersonID" class="form-label"></label>
                    <p id="SPPersonID" class="form-control bg-light" readonly>@Model.PersonID</p>
                    <input asp-for="PersonID" id="SPersonID" hidden />
                    <span asp-validation-for="PersonID" class="text-danger"></span>
                </div>

                <!-- تاريخ الدخول -->
                <div class="form-group mb-3">
                    <label asp-for="EntryDate" class="form-label"></label>
                    <input asp-for="EntryDate" class="form-control" />
                    <span asp-validation-for="EntryDate" class="text-danger"></span>
                </div>

                <!-- تاريخ الخروج -->
                <div class="form-group mb-3">
                    <label asp-for="ExitDate" class="form-label"></label>
                    <input asp-for="ExitDate" class="form-control" />
                    <span asp-validation-for="ExitDate" class="text-danger"></span>
                </div>

                <!-- حالة التفعيل -->
                <div class="form-group form-check mb-3">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="IsActiveCheck" />
                    <label class="form-check-label" for="IsActiveCheck">@Html.DisplayNameFor(model => model.IsActive)</label>
                </div>

                <!-- زر الإرسال -->
                <div class="form-group mt-4 d-grid gap-2 d-md-flex justify-content-md-between">
                    <button type="submit" class="btn btn-primary btn-lg px-4">حفظ</button>
                    <a asp-action="Index" class="btn btn-secondary btn-lg px-4">العودة إلى القائمة</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            $(document).on("personCardUpdated", function (event, personID) {
                if (personID) {
                    $("#SPersonID").val(personID);
                    $("#SPPersonID").html(personID);
                }
            });
        });
    </script>
}