@model BAL.ViewModel.clsStudentTableVieweModel
@{
    string prefix = ViewData.TemplateInfo.HtmlFieldPrefix ?? "";
    string uniqueId = prefix.Replace(".", "_");
}

<div class="container-fluid">
    <div class="mb-4 p-3 bg-light rounded shadow-sm">
        <div class="row g-3 align-items-center">

            <!-- خيار البحث -->
            <div class="col-12 col-md-auto d-flex align-items-center">
                <label for="searchFieldSelect" class="form-label mb-0 me-2">بحث حسب</label>
                <select id="searchFieldSelect" class="form-select w-auto">
                    <option selected value="-1">لا شيئ</option>
                    <option data-pattern="^\d{1,10}$" value="StudentID">معرف الطالب</option>
                    <option data-pattern="^\d{11}$" value="NationalNumber">الرقم الوطني</option>
                </select>
                <input type="text" id="searchInput" name="" class="form-control ms-2" style="min-width: 200px;" disabled placeholder="" />
            </div>

            <!-- زر البحث -->
            <div class="col-12 col-md-auto d-flex align-items-center">
                <button type="button" id="btnSearch" class="btn btn-primary">بحث</button>
            </div>
        </div>
    </div>

    <!-- مكان عرض بطاقة الطالب -->
    <div id="StudentCard" data-unique-id="@uniqueId" data-prefix="@prefix">
        @await Html.PartialAsync("~/Views/Student/StudentCard.cshtml", Model, ViewData)
    </div>
</div>

<!-- رابط jQuery -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script>
    $(document).ready(function () {
        // تحديث حقل البحث بناءً على نوع البحث المحدد
        $("#searchFieldSelect").on("change", function () {
            const selectedValue = $(this).val();
            const input = $("#searchInput");

            if (selectedValue === "-1") {
                input.attr("name", "").val("").prop("disabled", true);
            } else {
                input.attr("name", selectedValue).prop("disabled", false)
                    .attr("placeholder", "أدخل " + $(this).find("option:selected").text());
            }
        });

        // عند الضغط على زر البحث
        $("#btnSearch").on("click", function () {
            let input = $("#searchInput");
            let fieldName = input.attr("name");
            let fieldValue = input.val();

            if (!CheckIsValid(fieldValue)) return;

            let prefix = $('#StudentCard').data('prefix');

            let dataToSend = {};
            dataToSend[fieldName] = fieldValue;
            dataToSend["prefix"] = prefix;

            $.ajax({
                url: '/Student/ShowStudentCardWithFilter',
                type: 'POST',
                data: dataToSend,
                success: function (data) {
                    $('#StudentCard').html(data);

                    let StudentID = $(data).find(`#StudentID_${prefix}`).text();
                    const event = new CustomEvent("StudentCardUpdated", { detail: StudentID });
                    document.dispatchEvent(event);
                },
                error: function (xhr, status, error) {
                    alert("حدث خطأ أثناء البحث: " + error);
                }
            });
        });

        // التحقق من صحة القيمة المدخلة
        $("#searchInput").on("input", function () {
            CheckIsValid($(this).val());
        });

        // وظيفة التحقق من البيانات
        function CheckIsValid(fieldValue) {
            const selectedOption = $("#searchFieldSelect option:selected");
            const pattern = new RegExp(selectedOption.data("pattern"));

            $("#errorelement").remove();

            if (!pattern.test(fieldValue)) {
                const newElement = $("<p>", {
                    text: "القيمة غير صالحة",
                    class: "text-danger",
                    id: "errorelement"
                });
                $("#searchInput").after(newElement);
                return false;
            }

            return true;
        }
    });
</script>