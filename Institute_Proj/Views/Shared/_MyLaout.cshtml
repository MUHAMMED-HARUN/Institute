<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - منصة علمني الافتراضية </title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Institute_Proj.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/css/all.css">
    <link rel="stylesheet" href="~/css/MySite.css">
</head>
<body>

    <!-- Sidebar -->
    <div class="sideBarContiner">
        <i class="fa-solid fa-bars menu-icon"></i>


    <div class="sidebar">
        <h4 class="text-center py-3">لوحة التحكم</h4>

        <partial name="_LoginPartial" />

        <a href="/Home/Index"><i class="fa fa-home me-2"></i>الرئيسية</a>
        <hr />
        <a href="/People/Index"><i class="fa fa-users me-2"></i>الاشخاص</a>
        <hr />


       <div class="studentSidebar">
            <a href="/Student/Index"><i class="fa fa-user-graduate me-2"></i>الطلاب</a>
            <div class="studentPages">
                <a asp-action="EnrollInClass" asp-controller="Student">تسجيل طالب</a>
                <a asp-action="EnrollmentList" asp-controller="Student">لائحة التسجيلات</a>
            </div>
       </div>
        <hr />

        <div class="teacherSidebar">
        <a href="/Teacher/Index"><i class="fa fa-chalkboard-teacher me-2"></i>المعلمون</a>
            <div class="teacherPages">
                <a asp-action="EnrollInClass" asp-controller="Teacher">تسجيل معلم</a>
                <a asp-action="EnrollmentList" asp-controller="Teacher">لائحة التسجيلات</a>
            </div>
        </div>
        <hr />

        <a href="/QuranStudent/Index"><i class="fa fa-quran me-2"></i>طلاب القرآن</a>
        <hr />

            <a href="/Reading/Index"><i class="fa fa-calendar-day me-2"></i>أيام القراءة</a>
        <hr />
            <div class="TestSidebar">
                <a href="/Nomination/Index"><i class="fa fa-chalkboard-teacher me-2"></i>لائحة الاختبار</a>
                <div class="TestPages">
                    <a asp-action="Index" asp-controller="Test">نتائج الاختبارات</a>
                </div>
            </div>
        <hr />
            <a asp-area="Identity" asp-page="/Account/Register">انشاء مستخدم</a>
    </div>
    </div>
    <!-- Main content -->
    <div class="content w-100">
        <nav class="navbar navbar-expand navbar-custom mb-4 text-white px-3">
            <div class="container-fluid">
                <span class="navbar-brand text-white">منصة علمني الافتراضية</span>
                <span class="ms-auto">@DateTime.Now.ToString("dddd dd/MM/yyyy")</span>
            </div>
        </nav>

        <main role="main" class="container-fluid">
            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
