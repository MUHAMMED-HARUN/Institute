@using BAL.ViewModel;
@using BAL.interfaceCalsses;
@model clsCityAndCountryViewModel;
@inject IAddressService _addressServ;

@{
    string prefix = ViewData.TemplateInfo.HtmlFieldPrefix ?? "";
    string uniqueId = prefix.Replace(".", "_");

    // تحميل قائمة الدول من الـ Service
    SelectList CountryList = new SelectList(Model.countriys, "ID", "CountryName");
    SelectList CityList = new SelectList(Model.Cities, "ID", "CityName");
}

<div class="row mb-3" data-prefix="@prefix">
    <div class="col-md-6">
        <fieldset>
            <legend class="visually-hidden">بيانات الدولة والمدينة</legend>

            <!-- اختيار الدولة -->
            <div class="form-group mb-3">
                <label asp-for="SelectedCountryID" class="form-label"></label>
                <select asp-for="SelectedCountryID"
                        asp-items="CountryList"
                        id="SelectedCountryID_@uniqueId"
                        data-unique-id="@uniqueId"
                        data-prefix="@prefix"
                        class="form-select select-country">
                    <option value="">اختر دولة</option>
                </select>
                <span asp-validation-for="SelectedCountryID" class="text-danger"></span>
            </div>

            <!-- اختيار المدينة -->
            <div class="form-group mb-3">
                <label asp-for="PlaceOfBirthID" class="form-label"></label>
                <select asp-for="PlaceOfBirthID"
                        asp-items="CityList"
                        id="_CityAndCountry_@uniqueId"
                        data-unique-id="@uniqueId"
                        data-prefix="@prefix"
                        onchange="CitySelectChange();"
                        class="form-select select-city">
                    <option value="">اختر مدينة</option>
                </select>
                <span asp-validation-for="PlaceOfBirthID" class="text-danger"></span>
            </div>
        </fieldset>
    </div>
</div>