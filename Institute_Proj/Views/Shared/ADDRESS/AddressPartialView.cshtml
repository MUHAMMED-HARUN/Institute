@using BAL.ViewModel;
@using BAL.interfaceCalsses;
@model clsAddressPartialView;
@inject IAddressService _AddressServ;

@{
    string prefix = ViewData.TemplateInfo.HtmlFieldPrefix ?? "";
    string uniqueId = prefix.Replace(".", "_");

    SelectList Country = Model.Counties != null
        ? new SelectList(Model.Counties, "ID", "CountryName", Model.SelectedCountryID)
        : new SelectList(_AddressServ.GetCountryList(), "ID", "CountryName", Model.SelectedCountryID);

    SelectList Cities = new SelectList(Model.Cities, "ID", "CityName", Model.SelectedCityID);
    SelectList Districts = new SelectList(Model.Districts, "ID", "DistrictName", Model.SelectedDistrictID);
    SelectList Neighborhoods = new SelectList(Model.Neighborhoods, "ID", "NeighborhoodName", Model.SelectedNeighborhoodID);
}

<div class="row mb-4" data-prefix="@prefix">
    <div class="col-md-6">
        <fieldset>
            <legend class="visually-hidden">بيانات العنوان</legend>

            <!-- الدولة -->
            <div class="form-group mb-3">
                <label asp-for="SelectedCountryID" class="form-label"></label>
                <select asp-for="SelectedCountryID"
                        asp-items="Country"
                        id="SelectedCountryID_@uniqueId"
                        data-prefix="@prefix"
                        data-unique-id="@uniqueId"
                        onchange="CountrySelectChange();"
                        class="form-select select-country">
                    <option value="">اختر دولة</option>
                </select>
                <span asp-validation-for="SelectedCountryID" class="text-danger"></span>
            </div>

            <!-- المدينة -->
            <div class="form-group mb-3">
                <label asp-for="SelectedCityID" class="form-label"></label>
                <select asp-for="SelectedCityID"
                        asp-items="Cities"
                        id="SelectedCityID_@uniqueId"
                        data-prefix="@prefix"
                        data-unique-id="@uniqueId"
                        onchange="CitySelectChange();"
                        class="form-select select-city">
                    <option value="">اختر مدينة</option>
                </select>
                <span asp-validation-for="SelectedCityID" class="text-danger"></span>
            </div>

            <!-- القضاء -->
            <div class="form-group mb-3">
                <label asp-for="SelectedDistrictID" class="form-label"></label>
                <select asp-for="SelectedDistrictID"
                        asp-items="Districts"
                        id="SelectedDistrictID_@uniqueId"
                        data-prefix="@prefix"
                        data-unique-id="@uniqueId"
                        onchange="DistrictSelectChange();"
                        class="form-select select-district">
                    <option value="">اختر قضاء</option>
                </select>
                <span asp-validation-for="SelectedDistrictID" class="text-danger"></span>
            </div>

            <!-- الحي -->
            <div class="form-group mb-3">
                <label asp-for="SelectedNeighborhoodID" class="form-label"></label>
                <select asp-for="SelectedNeighborhoodID"
                        asp-items="Neighborhoods"
                        id="SelectedNeighborhoodID_@uniqueId"
                        data-prefix="@prefix"
                        data-unique-id="@uniqueId"
                        class="form-select select-neighborhood">
                    <option value="">اختر حيًا</option>
                </select>
                <span asp-validation-for="SelectedNeighborhoodID" class="text-danger"></span>
            </div>

            <!-- تفاصيل العنوان -->
            <div class="form-group mb-3">
                <label asp-for="AddressDetails" class="form-label"></label>
                <input asp-for="AddressDetails" class="form-control" />
                <span asp-validation-for="AddressDetails" class="text-danger"></span>
            </div>
        </fieldset>
    </div>
</div>